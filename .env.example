# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=course_assistant
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/course_assistant

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# LLM Configuration (Step 1)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_gemini_api_key_here

# Answering Configuration (Step 2)
SUPPORT_MIN_SCORE=0.25

# Evaluation Cost Configuration (price per 1M tokens)
PRICE_PER_1M_INPUT=0.0
PRICE_PER_1M_OUTPUT=0.0
